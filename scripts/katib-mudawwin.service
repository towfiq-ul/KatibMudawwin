# Example systemd --user unit for autostarting the engine on login.
#
# Install:
#   mkdir -p ~/.config/systemd/user
#   cp scripts/katib-mudawwin.service ~/.config/systemd/user/
#   # edit the ExecStart path below to match where you cloned this repo
#   systemctl --user daemon-reload
#   systemctl --user enable --now katib-mudawwin.service
#
# Logs: journalctl --user -u katib-mudawwin -f

[Unit]
Description=KātibMudawwin (local meeting note-taker)
After=graphical-session.target

[Service]
Type=simple
# Adjust this path if the repo isn't checked out at ~/KatibMudawwin
# (the default clone location used by install.sh)
ExecStart=%h/KatibMudawwin/engine/.venv/bin/katib-mudawwin
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
