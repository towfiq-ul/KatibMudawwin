# Example systemd --user unit for autostarting the engine on login.
#
# Install:
#   mkdir -p ~/.config/systemd/user
#   cp scripts/zoom-note-engine.service ~/.config/systemd/user/
#   # edit the ExecStart path below to match where you cloned this repo
#   systemctl --user daemon-reload
#   systemctl --user enable --now zoom-note-engine.service
#
# Logs: journalctl --user -u zoom-note-engine -f

[Unit]
Description=Zoom Notes Engine (local meeting note-taker)
After=graphical-session.target

[Service]
Type=simple
# Adjust this path if the repo isn't checked out at ~/workspace/zoom-app-screen-note-taker
ExecStart=%h/workspace/zoom-app-screen-note-taker/engine/.venv/bin/zoom-notes-engine
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
